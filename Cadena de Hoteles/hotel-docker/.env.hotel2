COMPOSE_PROJECT_NAME=hotel-2

# Base de datos Oracle LOCAL (corre en la maquina, no en Docker)
DB_SERVICE=XEPDB1
DB_USER=system
DB_PASS=meme1234

# Puertos de esta instancia
BACKEND_PORT=7002
FRONTEND_PORT=4002

# Puertos de sistemas externos (para CORS)
