COMPOSE_PROJECT_NAME=hotel-3

# Base de datos Oracle LOCAL (corre en la maquina, no en Docker)
DB_SERVICE=XEPDB1
DB_USER=hotel3
DB_PASS=pass_hotel3

# Puertos de esta instancia
BACKEND_PORT=7003
FRONTEND_PORT=4003

# Puertos de sistemas externos (para CORS)
AGENCY_PORT=5173
AIRLINE_PORT=5001

# Seguridad JWT — debe ser unico por instancia
JWT_SECRET=una_clave_muy_pero_muy_larga_de_mas_de_32_caracteres_aqui_3s

# .env.hotel1
COOKIE_NAME=auth_token_hotel3
