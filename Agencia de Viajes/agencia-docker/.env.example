COMPOSE_PROJECT_NAME=agencia

# ── MySQL LOCAL (corre en la máquina, no en Docker) ──
DB_PORT=3306
DB_NAME=agencia_viajes
DB_USER=root
DB_PASSWORD=tu_password_aqui

# ── Puertos ──
BACKEND_PORT=8001
FRONTEND_PORT=6001

# ── URLs de sistemas externos ──
AIRLINE_BACKEND_URL=http://localhost:5001
HOTEL_BACKEND_URL=http://localhost:7001

# ── Seguridad ──
JWT_SECRET=una_clave_muy_larga_y_segura_para_la_agencia_aqui
COOKIE_NAME=agencia_session

# ── SMTP ──
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_SENDER=tucorreo@gmail.com
