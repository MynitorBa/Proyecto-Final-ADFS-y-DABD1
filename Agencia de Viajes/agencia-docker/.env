# ── CONFIGURACIÓN DEL PROYECTO ──
COMPOSE_PROJECT_NAME=agencia-1

# ── BASE DE DATOS (MySQL en el Host) ──
# host.docker.internal permite que el contenedor salga a tu máquina local
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=agencia_viajes
DB_USER=root
DB_PASSWORD=

# ── PUERTOS (Mapeo de Docker) ──
# El frontend estará en http://localhost:6001
# El backend estará en http://localhost:8001
BACKEND_PORT=8001
FRONTEND_PORT=6001

# ── SERVIDOR (Configuración Interna del Binario) ──
SERVER_PORT=8080
SERVER_URL=http://localhost:8001

# ── SEGURIDAD Y SESIÓN ──
# Esta es la variable que inyectamos en el código de Go
